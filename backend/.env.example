APP_ENV=development
APP_NAME=Funny Chatbot API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql://chat_crazy:chat_crazy@localhost:5432/chat_crazy
GROQ_API_KEY=
GROQ_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_LLM_MODEL=
CHEAP_LLM_MODEL=
FALLBACK_LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=1024
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=chat_crazy_refresh
REFRESH_TOKEN_COOKIE_DOMAIN=
REFRESH_TOKEN_COOKIE_SAMESITE=lax
REFRESH_TOKEN_COOKIE_SECURE=
FRONTEND_ORIGINS=http://localhost:3000
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LOG_LEVEL=INFO
SENTRY_DSN=
METRICS_ENABLED=true
METRICS_TOKEN=
RATE_LIMIT_PER_MINUTE=60
MAX_INPUT_TOKENS=4096
MAX_OUTPUT_TOKENS=1024
CONVERSATION_WINDOW_MESSAGES=20
CONTEXT_TOKEN_BUDGET=4096
SUMMARY_MESSAGE_THRESHOLD=40
SUMMARY_TOKEN_THRESHOLD=3000

# Administrator Credentials (Used by `npm run create-admin`)
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=
