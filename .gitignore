# ==========================================
# Chat Crazy Monorepo Git Ignore Rules
# ==========================================

# ------------------------------------------
# Environment & Secret Files (CRITICAL)
# ------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env.local

# Allow example environment templates to be committed
!.env.example
!backend/.env.example
!frontend/.env.local.example

# ------------------------------------------
# Dependencies
# ------------------------------------------
node_modules/
backend/node_modules/
frontend/node_modules/
.pnpm-store/

# ------------------------------------------
# Build Outputs & Cache
# ------------------------------------------
dist/
backend/dist/
.next/
frontend/.next/
out/
frontend/out/
build/
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo
.turbo/

# ------------------------------------------
# Vercel Deployment Artifacts
# ------------------------------------------
.vercel/
backend/.vercel/
frontend/.vercel/

# ------------------------------------------
# Logs & Troubleshooting
# ------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ------------------------------------------
# Testing & Coverage
# ------------------------------------------
coverage/
backend/coverage/
.nyc_output/
htmlcov/
.coverage

# ------------------------------------------
# Operating System & IDE Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# ------------------------------------------
# Database Local Files
# ------------------------------------------
*.sqlite
*.sqlite-journal
*.db
*.db-journal
